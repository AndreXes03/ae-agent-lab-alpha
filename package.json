{
  "name": "ae-agent-lab",
  "version": "0.1.0-alpha.3-studio.3",
  "private": true,
  "description": "Experimental local After Effects agent bridge derived from kumo.productions' MIT runtime.",
  "keywords": [
    "adobe",
    "after-effects",
    "aftereffects",
    "claude",
    "extendscript",
    "llm",
    "mcp",
    "model-context-protocol",
    "motion-graphics"
  ],
  "homepage": "https://github.com/AndreXes03/ae-agent-lab-alpha",
  "license": "MIT",
  "bin": {
    "ae-agent-lab": "dist/index.js"
  },
  "files": [
    "dist",
    "jsx",
    "fixtures",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:jsx": "vitest run tests/lint-jsx.test.ts",
    "check:server-json": "node scripts/check-server-json.mjs",
    "docs:tools": "npm run build && node scripts/generate-tools-doc.mjs",
    "docs:tools:check": "npm run build && node scripts/generate-tools-doc.mjs --check",
    "check": "npm run typecheck && npm run typecheck:test && npm run lint && npm run format:check && npm run lint:jsx && npm run check:server-json && npm run docs:tools:check",
    "prepare": "lefthook install",
    "demo:start": "node scripts/demo-session.mjs start",
    "demo:status": "node scripts/demo-session.mjs status",
    "demo:stop": "node scripts/demo-session.mjs stop",
    "connect:codex": "node scripts/connect-codex.mjs",
    "demo:agent": "node scripts/run-client-demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "mcpName": "local.ae-agent-lab",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreXes03/ae-agent-lab-alpha.git"
  }
}

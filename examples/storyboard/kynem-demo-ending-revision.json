  "transitions": [
    {
      "id": "command_title",
      "fromScene": "command",
      "toScene": "title",
      "elementIds": [
        "commandPanel",
        "accentLine"
      ],
      "durationFrames": 18,
      "staggerFrames": 3,
      "curve": [
        0.42,
        0,
        0.58,
        1
      ],
      "recipe": "Espandi il pannello intorno al suo centro: da (160,250,960,180) a (160,160,960,400). La linea blu si sposta al titolo. Il comando lascia spazio al titolo con opacity in 6 frame; titolo e sottotitolo arrivano sfalsati di 3 frame.",
      "properties": [
        "Position",
        "Scale",
        "Opacity"
      ],
      "handoff": "Pannello e linea conservano identità e colore; stato finale A = stato iniziale B. Il raccordo occupa gli ultimi 18 frame della scena uscente, senza aggiungere durata."
    },
    {
      "id": "title_request",
      "fromScene": "title",
      "toScene": "request",
      "elementIds": [
        "commandPanel",
        "accentLine"
      ],
      "durationFrames": 18,
      "staggerFrames": 3,
      "curve": [
        0.42,
        0,
        0.58,
        1
      ],
      "recipe": "Comprimi il pannello alto a barra comando intorno al centro. Titolo e sottotitolo escono con opacity in 6 frame; richiesta entra dopo il ridimensionamento. Nessun pan del quadro.",
      "properties": [
        "Position",
        "Scale",
        "Opacity"
      ],
      "handoff": "La barra comando deriva dallo stesso commandPanel, con tipografia sempre nitida. Il raccordo occupa gli ultimi 18 frame della scena uscente, senza aggiungere durata."
    },
    {
      "id": "request_variants",
      "fromScene": "request",
      "toScene": "variants",
      "elementIds": [
        "commandPanel"
      ],
      "durationFrames": 24,
      "staggerFrames": 3,
      "curve": [
        0.42,
        0,
        0.58,
        1
      ],
      "recipe": "Il pannello si espande a contenitore delle preview. Le card compaiono con opacity e scala 96→100%, arrivi separati da 3 frame. Nessuna trasformazione arbitraria delle lettere.",
      "properties": [
        "Position",
        "Scale",
        "Opacity"
      ],
      "handoff": "Contenitore unico condiviso; card 1/2/3 sono nuovi elementi identificati e conservati. Il raccordo occupa gli ultimi 24 frame della scena uscente, senza aggiungere durata."
    },
    {
      "id": "variants_closing",
      "fromScene": "variants",
      "toScene": "closing",
      "elementIds": [
        "commandPanel",
        "variant2Panel"
      ],
      "durationFrames": 18,
      "staggerFrames": 3,
      "curve": [
        0.42,
        0,
        0.58,
        1
      ],
      "recipe": "La card centrale si sposta da (496,290,280,160) a (460,282,360,130), mantenendo centro e colore blu finale. Card laterali escono in 6 frame; titolo KYNEM e chiusura entrano 3 frame dopo. Breve settle di 4 frame e hold finale. La revisione cambia solo il testo finale; geometry, timing e raccordo restano identici.",
      "properties": [
        "Position",
        "Scale",
        "Opacity"
      ],
      "handoff": "variant2Panel resta lo stesso elemento; collegare il suo ultimo stato alla chiusura, non ricrearlo con un salto. Il raccordo occupa gli ultimi 18 frame della scena uscente, senza aggiungere durata."
    }
  ],
  "effects": [
    {
      "id": "controlledGlow",

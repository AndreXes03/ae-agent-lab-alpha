      "operations": [
        "layer.create_adjustment",
        "effect.add",
        "effect.set_property"
      ],
      "recipe": "Due glow opzionali: core radius 12px/intensity 0.45/threshold 80%; halo radius 48px/intensity 0.15/threshold 85%. Original Colors e Screen dopo ispezione enum. Il preview schematico omette entrambi.",
      "properties": [
        "Glow Radius",
        "Glow Intensity",
        "Glow Threshold",
        "Glow Colors",
        "Glow Operation"
      ],
      "verification": "Risolvere proprietà e unità native con il catalogo; inspect frame e playback del worker copiato. Non impostare enum numerici ipotizzati."
    }
